---
import fs from 'node:fs';
import path from 'node:path';
import { 
  ArrowLeft, 
  AlertTriangle, 
  MapPin, 
  Phone, 
  ExternalLink, 
  ClipboardList,
  Navigation,
  Layers,
  CalendarDays,
  Landmark,
  LayoutGrid,
  Bed,
  Bath,
  Ruler,
  Building2,
  KeyRound,
  TableProperties,
  Maximize2,
  ZoomIn,
  ZoomOut,
  RotateCcw,
  X
} from 'lucide-astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';

import projectsData from '../../data/projects.json';
import advisorsData from '../../data/advisors.json';
import companiesData from '../../data/companies.json';
import type { Project, Advisor, Company } from '../../types/index';

export async function getStaticPaths() {
  const projects = projectsData as Project[];
  const advisorsMap = new Map((advisorsData as Advisor[]).map((a) => [a.id, a]));
  const companiesMap = new Map((companiesData as Company[]).map((c) => [c.id, c]));

  return projects.map((project) => ({
    params: { slug: project.slug },
    props: {
      project,
      advisor: advisorsMap.get(project.asesorId),
      company: companiesMap.get(project.empresaId)
    }
  }));
}

interface Props {
  project: Project;
  advisor?: Advisor;
  company?: Company;
}

const { project, advisor, company } = Astro.props;

const LINK_STOCK_EDIFICA = 'https://www.dropbox.com/scl/fo/zh8zyeea685724doeqfdb/AP9VG3fCPRxnTFj_dJ2M0Rc/a.%20Stock%20de%20inmuebles?dl=0&preview=Stock+Disponible.xlsm&rlkey=os4bsfj1if9iumcavw2m0lt48&subfolder_nav_tracking=1';

const esEdificaSur = 
  company?.nombre?.trim().toUpperCase() === 'EDIFICA INVERSIONES DEL SUR SAC' ||
  project.empresaId.toLowerCase().includes('edifica-inversiones-del-sur');

const etapaLabelMap: Record<string, string> = {
  en_planos: 'En planos',
  en_construccion: 'En construcción',
  entrega_inmediata: 'Entrega inmediata'
};

const precioFormateado = project.precioMin
  ? new Intl.NumberFormat('es-PE', { style: 'currency', currency: 'PEN', maximumFractionDigits: 0 }).format(project.precioMin)
  : null;

// Helper Title Case
function toTitleCase(str: string): string {
  return str
    .toLowerCase()
    .split(/\s+/)
    .filter(Boolean)
    .map((palabra) => palabra.charAt(0).toUpperCase() + palabra.slice(1))
    .join(' ');
}

// WhatsApp Asesor
const primerAsesor = advisor?.nombre ? advisor.nombre.split('/')[0].trim() : 'Asesor';
const primerasDosPalabrasAsesor = primerAsesor.split(/\s+/).filter(Boolean).slice(0, 2).join(' ');
const asesorMensaje = toTitleCase(primerasDosPalabrasAsesor) || 'Asesor';
const proyectoMensaje = toTitleCase(project.nombre);

const primerTelefono = advisor?.telefono ? advisor.telefono.split('/')[0].trim() : '';
const digitosTelefono = primerTelefono.replace(/\D/g, '');
const telefonoWhatsApp = digitosTelefono.length === 9 && digitosTelefono.startsWith('9')
  ? `51${digitosTelefono}`
  : digitosTelefono;

const mensajeWhatsApp = encodeURIComponent(
  `Hola ${asesorMensaje}, me interesa el proyecto ${proyectoMensaje}`
);

const linkWhatsApp = telefonoWhatsApp 
  ? `https://wa.me/${telefonoWhatsApp}?text=${mensajeWhatsApp}` 
  : null;

// Lógica de Imagen de Stock
const stockFileName = `s-${project.slug}.webp`;
const stockDiskPath = path.resolve(process.cwd(), `public/images/stock/${stockFileName}`);
const hasStockImage = fs.existsSync(stockDiskPath);
const stockImageUrl = `/images/stock/${stockFileName}`;

// Búsqueda en Google Maps
const queryMapa = encodeURIComponent(
  [
    project.direccion,
    project.distrito,
    'Lima, Perú'
  ].filter(Boolean).join(', ')
);

const iframeMapUrl = `https://maps.google.com/maps?q=${queryMapa}&t=&z=16&ie=UTF8&iwloc=&output=embed`;
---

<BaseLayout title={`${project.nombre}`}>
  <Header />

  <main class="container page-main">
    <a href="/" class="back-link">
      <ArrowLeft size={16} />
      <span>Volver al catálogo</span>
    </a>

    {project.estado === 'vencido' && (
      <div class="banner-vencido" role="alert">
        <AlertTriangle size={18} class="banner-icon" />
        <div>
          <strong>Aviso:</strong> Este proyecto se encuentra vencido y no está disponible en el catálogo activo.
        </div>
      </div>
    )}

    <article class="project-detail">
      <header class="detail-header">
        <div class="title-company-wrapper">
          <div class="company-brand">
            <img 
              src={company?.logo || `/images/companies/${project.empresaId.toLowerCase()}.webp`} 
              alt={company?.nombre || 'Inmobiliaria'}
              class="company-logo-img"
              onerror="this.onerror=null; this.src='/images/companies/default.webp';"
            />
            <span class="company-name">{company?.nombre || 'Inmobiliaria'}</span>
          </div>
          <h1 class="project-title">{project.nombre}</h1>
          <p class="project-location">
            <MapPin size={16} class="location-icon" />
            <span>{project.distrito} {project.direccion ? `— ${project.direccion}` : ''}</span>
          </p>
        </div>

        {precioFormateado && (
          <div class="price-box">
            <span class="price-label">Precio desde</span>
            <span class="price-amount">{precioFormateado}</span>
          </div>
        )}
      </header>

      <div class="detail-grid">
        <div class="image-box">
          <img 
            src={project.imagen} 
            alt={project.nombre} 
            class="main-image"
            onerror="this.onerror=null; this.src='/images/projects/default.webp';"
          />
        </div>

        <div class="info-sidebar">
          <h3>Información del Proyecto</h3>
          <ul class="info-list">
            {project.etapa && (
              <li>
                <span class="info-label">
                  <Layers size={16} class="field-icon" />
                  <span>Etapa:</span>
                </span>
                <strong>{etapaLabelMap[project.etapa]}</strong>
              </li>
            )}

            {project.fechaEntrega && (
              <li>
                <span class="info-label">
                  <CalendarDays size={16} class="field-icon" />
                  <span>Entrega:</span>
                </span>
                <strong>{project.fechaEntrega.texto}</strong>
              </li>
            )}

            {project.financiamiento && project.financiamiento.length > 0 && (
              <li>
                <span class="info-label">
                  <Landmark size={16} class="field-icon" />
                  <span>Financiamiento:</span>
                </span>
                <strong>{project.financiamiento.join(', ')}</strong>
              </li>
            )}

            {project.tipologia && project.tipologia.length > 0 && (
              <li>
                <span class="info-label">
                  <LayoutGrid size={16} class="field-icon" />
                  <span>Tipología:</span>
                </span>
                <strong>{project.tipologia.join(', ')}</strong>
              </li>
            )}

            {project.habitaciones && project.habitaciones.length > 0 && (
              <li>
                <span class="info-label">
                  <Bed size={16} class="field-icon" />
                  <span>Habitaciones:</span>
                </span>
                <strong>{project.habitaciones.join(', ')} hab.</strong>
              </li>
            )}

            {project.banos && project.banos.length > 0 && (
              <li>
                <span class="info-label">
                  <Bath size={16} class="field-icon" />
                  <span>Baños:</span>
                </span>
                <strong>{project.banos.join(', ')} baños</strong>
              </li>
            )}

            {project.areaMin && (
              <li>
                <span class="info-label">
                  <Ruler size={16} class="field-icon" />
                  <span>Área:</span>
                </span>
                <strong>
                  {project.areaMin} m²{project.areaMax ? ` - ${project.areaMax} m²` : ''}
                </strong>
              </li>
            )}

            {project.pisosProyecto !== undefined && (
              <li>
                <span class="info-label">
                  <Building2 size={16} class="field-icon" />
                  <span>Pisos del proyecto:</span>
                </span>
                <strong>{project.pisosProyecto} pisos</strong>
              </li>
            )}

            {project.disponibles !== undefined && (
              <li>
                <span class="info-label">
                  <KeyRound size={16} class="field-icon" />
                  <span>Unidades estimadas:</span>
                </span>
                <strong>≥ {project.disponibles}</strong>
              </li>
            )}
          </ul>

          {advisor && (
            <div class="advisor-card">
              <div class="advisor-info-text">
                <h4>Asesor Responsable</h4>
                <p class="advisor-name">{advisor.nombre}</p>
                {advisor.telefono && (
                  <p class="advisor-phone">
                    <Phone size={15} />
                    <span>{advisor.telefono}</span>
                  </p>
                )}
              </div>

              {linkWhatsApp && (
                <a 
                  href={linkWhatsApp} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="advisor-whatsapp-btn"
                  title={`Contactar a ${asesorMensaje} por WhatsApp`}
                  aria-label={`Contactar a ${asesorMensaje} por WhatsApp`}
                >
                  <img src="/images/whatsapp-icon.svg" alt="WhatsApp" class="whatsapp-icon-svg" />
                </a>
              )}
            </div>
          )}

          <div class="action-buttons">
            {project.enlace && (
              <a href={project.enlace} target="_blank" rel="noopener noreferrer" class="external-btn">
                <ExternalLink size={16} />
                <span>Ver Drive / Web Oficial</span>
              </a>
            )}

            {esEdificaSur && (
              <a href={LINK_STOCK_EDIFICA} target="_blank" rel="noopener noreferrer" class="stock-btn">
                <ClipboardList size={16} />
                <span>Ver stock</span>
              </a>
            )}
          </div>
        </div>
      </div>

<!-- PANEL DE STOCK DISPONIBLE (IDs SUBIDOS A SIGI) -->
      {hasStockImage && (
        <section class="bottom-card stock-panel">
          <div class="bottom-card-header">
            <div class="bottom-card-title-group">
              <div class="bottom-card-title">
                <TableProperties size={18} class="section-icon" />
                <h3>IDs subidos a SIGI</h3>
              </div>
              <p class="stock-panel-subtitle">
                <AlertTriangle size={14} class="subtitle-alert-icon" />
                <span>
                  <strong>Importante:</strong> esta imagen no muestra todas las propiedades disponibles. Para consultar el stock completo y actualizado, haz clic en “Ver Stock” o “Ver Drive”.
                </span>
              </p>
            </div>
          
            <button 
              type="button" 
              id="btn-open-stock-modal" 
              class="bottom-card-action-btn"
              title="Ampliar imagen"
            >
              <Maximize2 size={14} />
              <span>Ampliar imagen</span>
            </button>
          </div>

          <div class="stock-image-container" id="stock-preview-trigger" title="Haz clic para ampliar">
            <img 
              src={stockImageUrl} 
              alt={`Stock disponible - ${project.nombre}`} 
              loading="lazy" 
              class="stock-image"
            />
          </div>
        </section>
      )}

      <!-- PANEL DE UBICACIÓN GMAPS -->
      <section class="bottom-card location-card">
        <div class="bottom-card-header">
          <div class="bottom-card-title">
            <Navigation size={18} class="section-icon" />
            <h3>Ubicación aproximada</h3>
          </div>
        </div>

        <div class="map-container">
          <iframe
            title={`Ubicación de ${project.nombre}`}
            src={iframeMapUrl}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>
      </section>
    </article>
  </main>

  <!-- MODAL / LIGHTBOX DE STOCK CON ZOOM Y ARRASTRE -->
  {hasStockImage && (
    <div id="stock-modal" class="stock-modal hidden" role="dialog" aria-modal="true" aria-label="Visor de stock">
      <div class="modal-backdrop" id="modal-backdrop"></div>

      <!-- BARRA DE HERRAMIENTAS SUPERIOR -->
      <div class="modal-toolbar">
        <div class="modal-controls">
          <button type="button" id="btn-zoom-out" class="control-btn" title="Alejar (-)">
            <ZoomOut size={18} />
          </button>
          <span id="zoom-level-text" class="zoom-text">100%</span>
          <button type="button" id="btn-zoom-in" class="control-btn" title="Acercar (+)">
            <ZoomIn size={18} />
          </button>
          <button type="button" id="btn-zoom-reset" class="control-btn" title="Restablecer">
            <RotateCcw size={16} />
          </button>
        </div>

        <button type="button" id="btn-modal-close" class="close-btn" title="Cerrar (Esc)">
          <X size={20} />
        </button>
      </div>

      <!-- ÁREA DE VISUALIZACIÓN -->
      <div class="modal-viewport" id="modal-viewport">
        <img 
          id="modal-stock-img" 
          src={stockImageUrl} 
          alt={`Stock disponible - ${project.nombre}`} 
          class="modal-stock-image"
          draggable="false"
        />
      </div>
    </div>
  )}
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('stock-modal');
    const backdrop = document.getElementById('modal-backdrop');
    const btnOpenModal = document.getElementById('btn-open-stock-modal');
    const previewTrigger = document.getElementById('stock-preview-trigger');
    const btnClose = document.getElementById('btn-modal-close');
    
    const viewport = document.getElementById('modal-viewport');
    const modalImg = document.getElementById('modal-stock-img') as HTMLImageElement | null;
    const zoomText = document.getElementById('zoom-level-text');
    const btnZoomIn = document.getElementById('btn-zoom-in');
    const btnZoomOut = document.getElementById('btn-zoom-out');
    const btnZoomReset = document.getElementById('btn-zoom-reset');

    if (!modal || !modalImg) return;

    let scale = 1;
    let posX = 0;
    let posY = 0;
    let isDragging = false;
    let startX = 0;
    let startY = 0;
    let hasMoved = false;

    function updateTransform(smooth = false) {
      if (!modalImg) return;
      modalImg.style.transition = smooth ? 'transform 0.2s ease' : 'none';
      modalImg.style.transform = `translate(${posX}px, ${posY}px) scale(${scale})`;
      
      if (zoomText) {
        zoomText.textContent = `${Math.round(scale * 100)}%`;
      }

      if (scale > 1) {
        modalImg.style.cursor = isDragging ? 'grabbing' : 'grab';
      } else {
        modalImg.style.cursor = 'zoom-in';
      }
    }

    function setZoom(newScale: number, smooth = true) {
      scale = Math.min(3.5, Math.max(0.75, newScale));
      if (scale <= 1) {
        posX = 0;
        posY = 0;
      }
      updateTransform(smooth);
    }

    function openModal() {
      modal?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      setZoom(1, false);
    }

    function closeModal() {
      modal?.classList.add('hidden');
      document.body.style.overflow = '';
      setZoom(1, false);
    }

    btnOpenModal?.addEventListener('click', openModal);
    previewTrigger?.addEventListener('click', openModal);
    btnClose?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);

    // Zoom con botones
    btnZoomIn?.addEventListener('click', () => setZoom(scale + 0.35));
    btnZoomOut?.addEventListener('click', () => setZoom(scale - 0.35));
    btnZoomReset?.addEventListener('click', () => setZoom(1));

    // Clic en la imagen: alternar entre 100% y 200%
    modalImg.addEventListener('click', () => {
      if (hasMoved) return; // Evitar alternar zoom si se estaba arrastrando
      if (scale === 1) {
        setZoom(2);
      } else {
        setZoom(1);
      }
    });

    // Zoom con la rueda del ratón
    viewport?.addEventListener('wheel', (e) => {
      e.preventDefault();
      const delta = e.deltaY < 0 ? 0.25 : -0.25;
      setZoom(scale + delta, false);
    }, { passive: false });

    // Panning (Arrastrar imagen cuando scale > 1)
    modalImg.addEventListener('mousedown', (e) => {
      if (scale <= 1) return;
      e.preventDefault();
      isDragging = true;
      hasMoved = false;
      startX = e.clientX - posX;
      startY = e.clientY - posY;
      updateTransform();
    });

    window.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      hasMoved = true;
      posX = e.clientX - startX;
      posY = e.clientY - startY;
      updateTransform(false);
    });

    window.addEventListener('mouseup', () => {
      if (isDragging) {
        isDragging = false;
        updateTransform();
      }
    });

    // Cerrar con Escape
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
        closeModal();
      }
    });
  });
</script>

<style>
  .page-main {
    padding-top: 1.5rem;
    padding-bottom: 4rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-remax-blue);
    text-decoration: none;
    font-weight: 700;
    margin-bottom: 1.25rem;
  }

  .banner-vencido {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background-color: #fef2f2;
    border: 1px solid #fca5a5;
    color: #991b1b;
    padding: 1rem;
    border-radius: var(--radius-md);
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
  }

  .banner-icon {
    flex-shrink: 0;
  }

  .detail-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 2rem;
  }

  @media (min-width: 768px) {
    .detail-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }
  }

  .company-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }

  .company-logo-img {
    height: 28px;
    width: auto;
    object-fit: contain;
  }

  .company-name {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .project-title {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-text-main);
  }

  .project-location {
    font-size: 0.95rem;
    color: var(--color-text-main);
    font-weight: 700;
    margin-top: 0.25rem;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .location-icon {
    color: var(--color-remax-blue);
  }

  .price-box {
    background-color: var(--color-surface);
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    display: inline-block;
  }

  .price-label {
    display: block;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .price-amount {
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--color-text-main);
  }

  .detail-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .image-box {
    width: 100%;
    aspect-ratio: 4 / 5;
    max-height: 660px;
    background-color: #e2e8f0;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .detail-grid {
      grid-template-columns: 1.2fr 1fr;
      align-items: start;
    }
  }

  .main-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .info-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .info-sidebar h3 {
    font-size: 1.1rem;
    font-weight: 800;
  }

  .info-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .info-list li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.9rem;
    border-bottom: 1px dashed var(--color-border);
    padding-bottom: 0.45rem;
  }

  .info-label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .field-icon {
    color: var(--color-remax-blue);
    flex-shrink: 0;
  }

  .advisor-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .advisor-info-text {
    display: flex;
    flex-direction: column;
  }

  .advisor-card h4 {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .advisor-name {
    font-weight: 800;
    margin-top: 0.25rem;
  }

  .advisor-phone {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-top: 0.25rem;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .advisor-whatsapp-btn {
    flex-shrink: 0;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background-color: #25d366;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 10px rgba(37, 211, 102, 0.35);
    transition: transform 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
    text-decoration: none;
  }

  .advisor-whatsapp-btn:hover {
    background-color: #1eb857;
    transform: scale(1.08) translateY(-2px);
    box-shadow: 0 6px 14px rgba(37, 211, 102, 0.45);
  }

  .whatsapp-icon-svg {
    width: 40px;
    height: 40px;
    display: block;
  }

  .action-buttons {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .external-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background-color: var(--color-remax-red);
    color: #ffffff;
    text-decoration: none;
    font-weight: 800;
    font-size: 0.95rem;
    padding: 0.875rem 1.25rem;
    border-radius: var(--radius-md);
    box-shadow: 0 4px 12px rgba(220, 28, 46, 0.25);
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .external-btn:hover {
    background-color: #b91c1c;
    transform: translateY(-2px);
  }

  .stock-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background-color: var(--color-remax-blue);
    color: #ffffff;
