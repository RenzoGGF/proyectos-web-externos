---
import '../styles/global.css';
import AgentModal from '../components/AgentModal.astro';
import TutorialModal from '../components/TutorialModal.astro';
import { AlertTriangle } from 'lucide-astro';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = 'Remax Family Proyectos',
  description = 'Consulta de proyectos disponibles'
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="layout-wrapper">
      <div class="layout-main-content">
        <slot />
      </div>

      <!-- FOOTER COMPACTO Y CENTRADO -->
      <footer class="site-footer">
        <div class="container footer-content">
          <div class="footer-card">
            <p class="footer-disclaimer">Información referencial. Sujeta a cambios.</p>

            <button type="button" id="btn-show-agent-modal" class="footer-agent-btn">
              <AlertTriangle size={14} class="footer-alert-icon" />
              <span>Uso exclusivo para agentes · Recomendaciones de uso</span>
            </button>
          </div>

          <span class="footer-brand">Remax Family</span>
        </div>
      </footer>
    </div>

    <!-- MODAL DE RECOMENDACIONES Y USO INTERNO -->
    <AgentModal />

    <!-- MODAL DE TUTORIALES DE YOUTUBE -->
    <TutorialModal />
  </body>
</html>

<style>
  .layout-wrapper {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .layout-main-content {
    flex: 1 0 auto;
  }

  .site-footer {
    flex-shrink: 0;
    padding: 2rem 0 1.75rem;
    margin-top: auto;
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    text-align: center;
  }

  .footer-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    padding: 0.85rem 1.5rem;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    max-width: 540px;
    width: 100%;
  }

  .footer-disclaimer {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .footer-agent-btn {
    background: none;
    border: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-text-main);
    cursor: pointer;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-md);
    transition: color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
  }

  .footer-alert-icon {
    color: var(--color-remax-red);
    flex-shrink: 0;
  }

  .footer-agent-btn:hover {
    color: var(--color-remax-blue);
    background-color: rgba(0, 61, 165, 0.06);
    transform: translateY(-1px);
  }

  .footer-brand {
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
</style>