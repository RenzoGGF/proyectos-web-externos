---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = 'Remax Family Proyectos',
  description = 'Consulta de proyectos disponibles'
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="layout-wrapper">
      <div class="layout-main-content">
        <slot />
      </div>

      <!-- FOOTER GLOBAL -->
      <footer class="site-footer">
        <div class="container">
          <p class="footer-disclaimer">
            Toda información debe tomarse como referencial y es sujeta a cambio.
          </p>
        </div>
      </footer>
    </div>
  </body>
</html>

<style>
  .layout-wrapper {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .layout-main-content {
    flex: 1 0 auto;
  }

  .site-footer {
    flex-shrink: 0;
    padding: 1.5rem 0;
    margin-top: auto;
    text-align: center;
  }

  .footer-disclaimer {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }
</style>