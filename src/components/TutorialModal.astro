---
import { CircleHelp, X } from 'lucide-astro';
---

<div 
  id="tutorial-modal" 
  class="tutorial-modal-overlay hidden" 
  role="dialog" 
  aria-modal="true" 
  aria-labelledby="tutorial-modal-title"
>
  <div class="tutorial-modal-backdrop" id="tutorial-modal-backdrop"></div>

  <div class="tutorial-modal-card">
    <div class="tutorial-modal-header">
      <div class="tutorial-modal-title-group">
        <CircleHelp size={20} class="tutorial-icon" />
        <h2 id="tutorial-modal-title" class="tutorial-modal-title">Tutorial</h2>
      </div>

      <button type="button" id="btn-close-tutorial" class="close-btn" title="Cerrar (Esc)" aria-label="Cerrar tutorial">
        <X size={20} />
      </button>
    </div>

    <div class="tutorial-video-wrapper">
      <iframe 
        id="tutorial-iframe" 
        title="Reproductor de tutorial"
        src="" 
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
        allowfullscreen
      ></iframe>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('tutorial-modal');
    const backdrop = document.getElementById('tutorial-modal-backdrop');
    const btnClose = document.getElementById('btn-close-tutorial');
    const iframe = document.getElementById('tutorial-iframe') as HTMLIFrameElement | null;
    const titleEl = document.getElementById('tutorial-modal-title');

    if (!modal || !iframe) return;

    function openModal(youtubeId: string, title?: string) {
      if (!youtubeId || !iframe) return;
      iframe.src = `https://www.youtube-nocookie.com/embed/${youtubeId}?autoplay=1&rel=0`;
      if (titleEl && title) {
        titleEl.textContent = title;
      }
      modal?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (iframe) {
        iframe.src = ''; // Detiene el video y libera memoria
      }
      modal?.classList.add('hidden');
      document.body.style.overflow = '';
    }

    // Delegación global para disparar cualquier tutorial en la web
    document.addEventListener('click', (e) => {
      const trigger = (e.target as HTMLElement)?.closest<HTMLElement>('.js-tutorial-trigger');
      if (trigger) {
        e.preventDefault();
        const videoId = trigger.dataset.videoId;
        const title = trigger.dataset.videoTitle;
        if (videoId) {
          openModal(videoId, title);
        }
      }
    });

    btnClose?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
        closeModal();
      }
    });
  });
</script>

<style>
  .tutorial-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 2000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    overflow-y: auto;
  }

  .tutorial-modal-backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .tutorial-modal-card {
    position: relative;
    z-index: 2005;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-elevated);
    max-width: 820px;
    width: 100%;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    animation: modalAppear 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes modalAppear {
    from {
      opacity: 0;
      transform: scale(0.96) translateY(8px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .tutorial-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
    background-color: #ffffff;
  }

  .tutorial-modal-title-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .tutorial-icon {
    color: var(--color-remax-blue);
    flex-shrink: 0;
  }

  .tutorial-modal-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--color-text-main);
  }

  .close-btn {
    background: none;
    border: none;
    color: var(--color-text-muted);
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .close-btn:hover {
    background-color: #fee2e2;
    color: var(--color-remax-red);
  }

  .tutorial-video-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #000000;
  }

  .tutorial-video-wrapper iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }
</style>