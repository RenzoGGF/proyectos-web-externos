---
import { CircleHelp, X, ArrowLeft, Play, Clock } from 'lucide-astro';

interface TutorialItem {
  id: string;
  titulo: string;
  youtubeId?: string; // Deja vacío o undefined para marcar como próximamente disponible
}

// CONFIGURACIÓN CENTRALIZADA DE TUTORIALES
const TUTORIALS: TutorialItem[] = [
  {
    id: 'uso-pagina',
    titulo: '¿Cómo usar la página?',
    youtubeId: 'Ol3r5ykgjks' // Video activo
  },
  {
    id: 'drive-tyc',
    titulo: '¿Cómo usar el Drive de TyC?',
    youtubeId: 'lrm9pKbHU-o' // Próximamente
  },
  {
    id: 'drive-edifica',
    titulo: '¿Cómo usar el Drive de Edifica?',
    youtubeId: '' // Próximamente
  },
  {
    id: 'drive-illusione',
    titulo: '¿Cómo usar el Drive de Illusione?',
    youtubeId: '' // Próximamente
  }
];
---

<div 
  id="tutorial-modal" 
  class="tutorial-modal-overlay hidden" 
  role="dialog" 
  aria-modal="true" 
  aria-labelledby="tutorial-modal-title"
>
  <div class="tutorial-modal-backdrop" id="tutorial-modal-backdrop"></div>

  <div class="tutorial-modal-card">
    <!-- ENCABEZADO DINÁMICO -->
    <div class="tutorial-modal-header">
      <!-- VISTA 1: TÍTULO CUADRÍCULA -->
      <div id="modal-header-grid" class="header-title-group">
        <CircleHelp size={20} class="header-icon" />
        <h2 id="tutorial-modal-title" class="modal-title">Tutoriales de uso</h2>
      </div>

      <!-- VISTA 2: BOTÓN VOLVER + TÍTULO DEL VIDEO -->
      <div id="modal-header-player" class="header-back-group hidden">
        <button type="button" id="btn-back-to-grid" class="back-nav-btn">
          <ArrowLeft size={16} />
          <span>Volver a tutoriales</span>
        </button>
        <span class="active-video-title" id="active-video-title"></span>
      </div>

      <button type="button" id="btn-close-tutorial" class="close-btn" title="Cerrar (Esc)" aria-label="Cerrar modal">
        <X size={20} />
      </button>
    </div>

    <!-- CONTENIDO: VISTA 1 (CUADRÍCULA 2x2) -->
    <div id="tutorial-grid-view" class="tutorial-grid-container">
      <div class="tutorial-grid">
        {TUTORIALS.map((tutorial) => {
          const isAvailable = Boolean(tutorial.youtubeId?.trim());

          return isAvailable ? (
            <button 
              type="button" 
              class="tutorial-card is-active" 
              data-youtube-id={tutorial.youtubeId}
              data-title={tutorial.titulo}
            >
              <div class="card-icon-wrapper play-icon-wrapper">
                <Play size={20} class="play-icon" />
              </div>
              <div class="card-text-wrapper">
                <h3 class="card-title">{tutorial.titulo}</h3>
                <span class="card-status-available">Ver video</span>
              </div>
            </button>
          ) : (
            <div class="tutorial-card is-disabled" aria-disabled="true">
              <div class="card-icon-wrapper pending-icon-wrapper">
                <Clock size={18} class="pending-icon" />
              </div>
              <div class="card-text-wrapper">
                <h3 class="card-title">{tutorial.titulo}</h3>
                <span class="card-status-pending">Tutorial próximamente disponible...</span>
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <!-- CONTENIDO: VISTA 2 (REPRODUCTOR DE VIDEO) -->
    <div id="tutorial-player-view" class="tutorial-player-container hidden">
      <div class="tutorial-video-wrapper">
        <iframe 
          id="tutorial-iframe" 
          title="Reproductor de tutorial"
          src="" 
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('tutorial-modal');
    const backdrop = document.getElementById('tutorial-modal-backdrop');
    const btnOpen = document.getElementById('btn-open-tutorial');
    const btnClose = document.getElementById('btn-close-tutorial');
    const btnBack = document.getElementById('btn-back-to-grid');

    const headerGrid = document.getElementById('modal-header-grid');
    const headerPlayer = document.getElementById('modal-header-player');
    const activeVideoTitleEl = document.getElementById('active-video-title');

    const gridView = document.getElementById('tutorial-grid-view');
    const playerView = document.getElementById('tutorial-player-view');
    const iframe = document.getElementById('tutorial-iframe') as HTMLIFrameElement | null;

    const cards = document.querySelectorAll<HTMLButtonElement>('.tutorial-card.is-active');

    if (!modal || !iframe) return;

    // Detiene la reproducción y limpia el iframe de YouTube
    function stopAndClearVideo() {
      if (iframe) {
        iframe.src = '';
      }
    }

    // Regresa a la vista de cuadrícula 2x2
    function switchToGridView() {
      stopAndClearVideo();
      playerView?.classList.add('hidden');
      headerPlayer?.classList.add('hidden');

      gridView?.classList.remove('hidden');
      headerGrid?.classList.remove('hidden');
    }

    // Carga el iframe bajo demanda y activa la vista del reproductor
    function switchToPlayerView(youtubeId: string, title: string) {
      if (!iframe) return;
      
      iframe.src = `https://www.youtube-nocookie.com/embed/${youtubeId}?autoplay=1&rel=0`;
      
      if (activeVideoTitleEl) {
        activeVideoTitleEl.textContent = title;
      }

      gridView?.classList.add('hidden');
      headerGrid?.classList.add('hidden');

      headerPlayer?.classList.remove('hidden');
      playerView?.classList.remove('hidden');
    }

    function openModal() {
      switchToGridView();
      modal?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      stopAndClearVideo();
      modal?.classList.add('hidden');
      document.body.style.overflow = '';
      switchToGridView();
    }

    btnOpen?.addEventListener('click', openModal);
    btnClose?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);
    btnBack?.addEventListener('click', switchToGridView);

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const youtubeId = card.dataset.youtubeId;
        const title = card.dataset.title || 'Tutorial';
        if (youtubeId) {
          switchToPlayerView(youtubeId, title);
        }
      });
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  });
</script>

<style>
  .tutorial-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 2000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    overflow-y: auto;
  }

  .tutorial-modal-backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .tutorial-modal-card {
    position: relative;
    z-index: 2005;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-elevated);
    max-width: 820px;
    width: 100%;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    animation: modalAppear 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes modalAppear {
    from {
      opacity: 0;
      transform: scale(0.96) translateY(8px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  /* ENCABEZADO */
  .tutorial-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
    background-color: #ffffff;
  }

  .header-title-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .header-icon {
    color: var(--color-remax-blue);
    flex-shrink: 0;
  }

  .modal-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--color-text-main);
  }

  /* BARRA DE NAVEGACIÓN DENTRO DEL REPRODUCTOR */
  .header-back-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .back-nav-btn {
    background: none;
    border: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-remax-blue);
    cursor: pointer;
    padding: 0.35rem 0.6rem;
    border-radius: var(--radius-md);
    background-color: #eff6ff;
    flex-shrink: 0;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .back-nav-btn:hover {
    background-color: var(--color-remax-blue);
    color: #ffffff;
  }

  .active-video-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-text-main);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .close-btn {
    background: none;
    border: none;
    color: var(--color-text-muted);
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .close-btn:hover {
    background-color: #fee2e2;
    color: var(--color-remax-red);
  }

  /* CUADRÍCULA DE TUTORIALES: 1x4 en mobile, 2x2 en PC */
  .tutorial-grid-container {
    padding: 1.25rem;
    background-color: #f8fafc;
  }

  .tutorial-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .tutorial-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* TARJETAS LIMPIAS */
  .tutorial-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.15rem 1rem;
    border-radius: var(--radius-md);
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    text-align: left;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .tutorial-card.is-active {
    cursor: pointer;
  }

  .tutorial-card.is-active:hover {
    border-color: var(--color-remax-blue);
    box-shadow: 0 4px 14px rgba(0, 61, 165, 0.1);
    transform: translateY(-2px);
  }

  .tutorial-card.is-disabled {
    background-color: #f1f5f9;
    border-color: #e2e8f0;
    cursor: not-allowed;
    opacity: 0.85;
  }

  /* ICONOS DE TARJETAS */
  .card-icon-wrapper {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .play-icon-wrapper {
    background-color: #eff6ff;
    color: var(--color-remax-blue);
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .tutorial-card.is-active:hover .play-icon-wrapper {
    background-color: var(--color-remax-blue);
    color: #ffffff;
  }

  .pending-icon-wrapper {
    background-color: #e2e8f0;
    color: var(--color-text-muted);
  }

  .card-text-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .card-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text-main);
    line-height: 1.35;
  }

  .card-status-available {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-remax-blue);
  }

  .card-status-pending {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  /* REPRODUCTOR 16:9 */
  .tutorial-player-container {
    width: 100%;
    background-color: #000000;
  }

  .tutorial-video-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
  }

  .tutorial-video-wrapper iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }
</style>