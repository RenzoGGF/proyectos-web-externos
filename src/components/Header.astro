---
import { Search, CircleHelp } from 'lucide-astro';
---

<header class="site-header">
  <div class="container header-content">
    <a href="/" class="brand-link" title="Volver al catálogo principal">
      <img 
        src="/images/logo.webp" 
        alt="Logo Principal" 
        class="brand-logo-img" 
        onerror="this.onerror=null; this.src='/images/default-logo.webp';"
      />
      <div class="brand-divider"></div>
      <span class="brand-title">Proyectos en oficina</span>
    </a>

    <div class="header-actions">
      <!-- BUSCADOR -->
      <form action="/" method="GET" class="header-search-form" role="search">
        <div class="search-input-wrapper">
          <Search size={16} class="search-icon" />
          <input 
            type="search" 
            name="q" 
            id="header-search-input" 
            class="header-search-input"
            placeholder="Buscar por proyecto..." 
            autocomplete="off"
          />
        </div>
      </form>

      <!-- BOTÓN TUTORIALES CON ICONO CIRCLE HELP -->
      <button 
        type="button" 
        id="btn-open-tutorial" 
        class="header-tutorial-btn" 
        title="Ver tutoriales"
        aria-label="Ver tutoriales"
      >
        <CircleHelp size={16} class="btn-help-icon" />
        <span class="btn-text">Tutoriales</span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(2px);
    border-bottom: 2px solid var(--color-remax-blue);
    box-shadow: 0 0 20px var(--color-text-main);
  }

  .header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    height: 70px;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand-logo-img {
    height: 48px;
    width: auto;
    object-fit: contain;
  }

  .brand-divider {
    width: 1px;
    height: 24px;
    background-color: var(--color-border);
  }

  .brand-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text-main);
    white-space: nowrap;
  }

  /* CONTENEDOR DE ACCIONES DERECHA */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-shrink: 0;
  }

  /* BARRA DE BÚSQUEDA */
  .header-search-form {
    display: flex;
    align-items: center;
    max-width: 280px;
    width: 100%;
  }

  .search-input-wrapper {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 0.75rem;
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .header-search-input {
    width: 100%;
    height: 36px;
    padding: 0 0.75rem 0 2.25rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text-main);
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    background-color: #ffffff;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .header-search-input:focus {
    border-color: var(--color-remax-blue);
    box-shadow: 0 0 0 3px rgba(0, 61, 165, 0.12);
  }

  /* BOTÓN TUTORIALES */
  .header-tutorial-btn {
    height: 36px;
    padding: 0 0.85rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    background-color: #eff6ff;
    color: var(--color-remax-blue);
    border: 1px solid #bfdbfe;
    border-radius: 9999px;
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    box-sizing: border-box;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.15s ease;
  }

  .header-tutorial-btn:hover {
    background-color: var(--color-remax-blue);
    color: #ffffff;
    border-color: var(--color-remax-blue);
    transform: translateY(-1px);
  }

  .btn-help-icon {
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .brand-title, .brand-divider {
      display: none;
    }

    .header-search-form {
      max-width: 180px;
    }

    .header-tutorial-btn {
      width: 36px;
      padding: 0;
      border-radius: 50%;
    }

    .header-tutorial-btn .btn-text {
      display: none;
    }
  }
</style>