---
import { Search, CircleHelp, MapPinned, LayoutGrid } from 'lucide-astro';
import { GENERAL_TUTORIAL } from '../config/tutorials';

const isMapPage = Astro.url.pathname.startsWith('/mapa');
---

<header class="site-header">
  <div class="container header-content">
    <a href="/" class="brand-link" title="Volver al catálogo principal">
      <img 
        src="/images/logo.webp" 
        alt="Logo Principal" 
        class="brand-logo-img" 
        onerror="this.onerror=null; this.src='/images/default-logo.webp';"
      />
      <div class="brand-divider"></div>
      <span class="brand-title">Proyectos en oficina</span>
    </a>

    <div class="header-actions">
      <!-- BUSCADOR (COLAPSABLE EN MOBILE) -->
      <form action="/" method="GET" class="header-search-form" role="search">
        <div class="search-input-wrapper">
          <Search size={16} class="search-icon" />
          <input 
            type="search" 
            name="q" 
            id="header-search-input" 
            class="header-search-input"
            placeholder="Buscar..." 
            autocomplete="off"
            aria-label="Buscar proyecto"
          />
        </div>
      </form>

      <!-- BOTÓN GLOBAL NAVEGACIÓN MAPA / CATÁLOGO -->
      {isMapPage ? (
        <a href="/" class="header-nav-link" title="Volver al catálogo de proyectos" aria-label="Volver al catálogo de proyectos">
          <LayoutGrid size={16} class="btn-nav-icon" />
          <span class="btn-nav-text">Catálogo</span>
        </a>
      ) : (
        <a href="/mapa" class="header-nav-link" title="Ver proyectos en el mapa" aria-label="Ver proyectos en el mapa">
          <MapPinned size={16} class="btn-nav-icon" />
          <span class="btn-nav-text">Mapa</span>
        </a>
      )}

      <!-- BOTÓN DIRECTO AL TUTORIAL GENERAL -->
      <button 
        type="button" 
        class="header-tutorial-btn js-tutorial-trigger" 
        data-video-id={GENERAL_TUTORIAL.youtubeId}
        data-video-title={GENERAL_TUTORIAL.titulo}
        title={GENERAL_TUTORIAL.titulo}
        aria-label={GENERAL_TUTORIAL.titulo}
      >
        <CircleHelp size={16} class="btn-help-icon" />
        <span class="btn-text">Tutorial</span>
        <span class="point" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    border-bottom: 2px solid var(--color-remax-blue);
    box-shadow: 0 0 20px var(--color-text-main);
  }

  .header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    height: 70px;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand-logo-img {
    height: 46px;
    width: auto;
    object-fit: contain;
  }

  .brand-divider {
    width: 1px;
    height: 24px;
    background-color: var(--color-border);
  }

  .brand-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text-main);
    white-space: nowrap;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .header-search-form {
    display: flex;
    align-items: center;
    max-width: 240px;
    width: 100%;
    transition: width 0.25s ease, max-width 0.25s ease;
  }

  .search-input-wrapper {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 0.75rem;
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .header-search-input {
    width: 100%;
    height: 36px;
    padding: 0 0.75rem 0 2.25rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text-main);
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    background-color: #ffffff;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
  }

  .header-search-input:focus {
    border-color: var(--color-remax-blue);
    box-shadow: 0 0 0 3px rgba(0, 61, 165, 0.12);
  }

  /* BOTÓN NAVEGACIÓN MAPA / CATÁLOGO (FUENTE REGULAR / NO BOLD) */
  .header-nav-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    height: 36px;
    padding: 0 0.85rem;
    background-color: #eff6ff;
    color: var(--color-remax-blue, #003da5);
    border: 1px solid #bfdbfe;
    border-radius: 9999px;
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: none;
    line-height: 1;
    white-space: nowrap;
    flex-shrink: 0;
    box-sizing: border-box;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.15s ease;
  }

  .header-nav-link:visited {
    color: var(--color-remax-blue, #003da5);
  }

  .header-nav-link:hover {
    background-color: var(--color-remax-blue, #003da5);
    color: #ffffff;
    border-color: var(--color-remax-blue, #003da5);
    transform: translateY(-1px);
  }

  .header-nav-link:hover .btn-nav-icon,
  .header-nav-link:hover .btn-nav-text {
    color: #ffffff;
  }

  .btn-nav-icon {
    flex-shrink: 0;
    display: block;
  }

  .btn-nav-text {
    font-weight: 500;
  }

  /* BOTÓN TUTORIAL */
  .header-tutorial-btn {
    position: relative;
    height: 36px;
    padding: 0 0.85rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    background-color: #eff6ff;
    color: var(--color-remax-blue, #003da5);
    border: 1px solid #bfdbfe;
    border-radius: 9999px;
    font-size: 0.82rem;
    font-weight: 500;
    line-height: 1;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    box-sizing: border-box;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.15s ease;
  }

  .header-tutorial-btn:hover {
    background-color: var(--color-remax-blue, #003da5);
    color: #ffffff;
    border-color: var(--color-remax-blue, #003da5);
    transform: translateY(-1px);
  }

  .btn-help-icon {
    flex-shrink: 0;
  }

  /* PUNTO INDICADOR CON PULSO ROJO */
  .point {
    position: relative;
    width: 6px;
    height: 6px;
    background-color: rgb(255, 0, 0);
    border-radius: 25px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .point::before {
    content: "";
    position: absolute;
    width: 1px;
    height: 1px;
    background-color: rgb(255, 0, 0);
    border-radius: 25px;
    animation: loop 1s 0s infinite;
  }

  @keyframes loop {
    0% {
      background-color: rgb(255, 0, 0);
      width: 1px;
      height: 1px;
    }

    100% {
      background-color: rgba(255, 0, 0, 0);
      width: 20px;
      height: 20px;
    }
  }

  @media (max-width: 768px) {
    .site-header {
      overflow-x: clip;
    }

    .header-content {
      padding: 0 0.75rem;
      gap: 0.5rem;
      height: 60px;
    }

    .brand-link {
      gap: 0.5rem;
    }

    .brand-logo-img {
      height: 38px;
    }

    .brand-title, .brand-divider {
      display: none;
    }

    .header-actions {
      gap: 0.4rem;
    }

    /* Buscador colapsable en móvil */
    .header-search-form {
      max-width: 36px;
      width: 36px;
    }

    .header-search-form:focus-within,
    .header-search-form:has(.header-search-input:not(:placeholder-shown)) {
      max-width: 130px;
      width: 130px;
    }

    .header-search-form:not(:focus-within):not(:has(.header-search-input:not(:placeholder-shown))) .header-search-input {
      cursor: pointer;
      background-color: #f1f5f9;
      padding-left: 2.25rem;
      padding-right: 0;
    }

    .header-search-form:not(:focus-within):not(:has(.header-search-input:not(:placeholder-shown))) .header-search-input::placeholder {
      color: transparent;
    }

    /* Botón mapa en mobile: solo icono circular 36x36px */
    .header-nav-link {
      width: 36px;
      height: 36px;
      padding: 0;
      border-radius: 50%;
      justify-content: center;
    }

    .header-nav-link .btn-nav-text {
      display: none;
    }

    /* Botón tutorial en mobile: solo icono circular 36x36px */
    .header-tutorial-btn {
      width: 36px;
      height: 36px;
      padding: 0;
      border-radius: 50%;
      justify-content: center;
    }

    .header-tutorial-btn .btn-text {
      display: none;
    }

    .header-tutorial-btn .point {
      position: absolute;
      top: 5px;
      right: 5px;
    }
  }
</style>