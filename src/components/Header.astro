---
import { Search } from 'lucide-astro';
---

<header class="site-header">
  <div class="container header-content">
    <a href="/" class="brand-link" title="Volver al catálogo principal">
      <img 
        src="/images/logo.webp" 
        alt="Logo Principal" 
        class="brand-logo-img" 
        onerror="this.onerror=null; this.src='/images/default-logo.webp';"
      />
      <div class="brand-divider"></div>
      <span class="brand-title">Proyectos en oficina</span>
    </a>

    <!-- BUSCADOR POR NOMBRE DE PROYECTO -->
    <form action="/" method="GET" class="header-search-form" role="search">
      <div class="search-input-wrapper">
        <Search size={16} class="search-icon" />
        <input 
          type="search" 
          name="q" 
          id="header-search-input" 
          class="header-search-input"
          placeholder="Buscar proyecto..." 
          autocomplete="off"
        />
      </div>
    </form>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(2px);
    border-bottom: 2px solid var(--color-remax-blue);
    box-shadow: 0 0 20px var(--color-text-main);
  }

  .header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    height: 70px;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand-logo-img {
    height: 48px;
    width: auto;
    object-fit: contain;
  }

  .brand-divider {
    width: 1px;
    height: 24px;
    background-color: var(--color-border);
  }

  .brand-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text-main);
    white-space: nowrap;
  }

  /* BARRA DE BÚSQUEDA */
  .header-search-form {
    display: flex;
    align-items: center;
    max-width: 320px;
    width: 100%;
  }

  .search-input-wrapper {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 0.75rem;
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .header-search-input {
    width: 100%;
    padding: 0.45rem 0.75rem 0.45rem 2.25rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text-main);
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    background-color: #ffffff;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .header-search-input:focus {
    border-color: var(--color-remax-blue);
    box-shadow: 0 0 0 3px rgba(0, 61, 165, 0.12);
  }

  @media (max-width: 640px) {
    .brand-title, .brand-divider {
      display: none; /* Ahorra espacio en pantallas móviles pequeñas */
    }
    .header-search-form {
      max-width: 220px;
    }
  }
</style>